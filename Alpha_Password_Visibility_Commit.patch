From fa2e2207eeabc090d0fd0dd8f72977079fb382e3 Mon Sep 17 00:00:00 2001
From: Project Alpha <alpha@example.invalid>
Date: Tue, 17 Nov 2026 23:42:24 -0500
Subject: [PATCH] Add show and hide controls to password fields

---
 public/session.js | 34 +++++++++++++++++++++++++++++++++-
 public/styles.css | 34 ++++++++++++++++++++++++++++++++++
 2 files changed, 67 insertions(+), 1 deletion(-)

diff --git a/public/session.js b/public/session.js
index e7d69a7..0ac3811 100644
--- a/public/session.js
+++ b/public/session.js
@@ -5,10 +5,42 @@ export async function api(path,body){
  let value;try{value=await response.json();}catch{throw Object.assign(new Error('The server response was incomplete. Your draft is preserved.'),{ambiguous:!!body});}
  if(!response.ok)throw Object.assign(new Error(value.error?.message||value.error||value.message||'The request could not be completed.'),{status:response.status,code:value.code,ambiguous:response.status>=500});return value;
 }
+function passwordField(mode) {
+  const autocomplete = mode === 'signin' ? 'current-password' : 'new-password';
+  return `<div class="field">
+    <label for="auth-password">Password</label>
+    <div class="auth-password-control">
+      <input id="auth-password" name="password" type="password" required minlength="12" maxlength="128"
+        autocomplete="${autocomplete}" aria-describedby="auth-password-hint">
+      <button type="button" class="btn btn-secondary auth-password-toggle"
+        aria-controls="auth-password" aria-label="Show password">
+        <span class="auth-password-eye" aria-hidden="true"></span>
+        <span class="auth-password-action">Show</span>
+      </button>
+    </div>
+    <small id="auth-password-hint">At least 12 characters.</small>
+  </div>`;
+}
+
+function bindPasswordVisibility(form) {
+  const input = form.querySelector('#auth-password');
+  const toggle = form.querySelector('.auth-password-toggle');
+  if (!input || !toggle) return;
+
+  const action = toggle.querySelector('.auth-password-action');
+  toggle.addEventListener('click', () => {
+    const reveal = input.type === 'password';
+    input.type = reveal ? 'text' : 'password';
+    toggle.setAttribute('aria-label', reveal ? 'Hide password' : 'Show password');
+    action.textContent = reveal ? 'Hide' : 'Show';
+  });
+}
+
 export function showAuth(onSignedIn,message=''){
  const target=document.querySelector('#main');let mode=location.pathname==='/reset-password'?(new URLSearchParams(location.search).has('token')?'reset':'forgot'):'signin';
  function draw(){
-  target.innerHTML=`<section class="card auth-card"><div class="card-head"><div><span class="eyebrow">YOUR INDEPENDENT ALPHA ACCOUNT</span><h1>${{signin:'Welcome back.',signup:'A workspace of your own.',forgot:'Reset your password.',reset:'Choose a new password.'}[mode]}</h1><p>${mode==='signup'?'Private pilot registration is restricted to invited email addresses.':'Personal records stay private to your account.'}</p></div></div><form id="auth-form" class="card-body"><div class="auth-fields">${mode==='signup'?'<label class="field">Your name<input name="name" required maxlength="100" autocomplete="name"></label>':''}${mode!=='reset'?'<label class="field">Email address<input name="email" type="email" required maxlength="254" autocomplete="email"></label>':''}${mode!=='forgot'?'<label class="field">Password<input name="password" type="password" required minlength="12" maxlength="128" autocomplete="'+(mode==='signin'?'current-password':'new-password')+'"><small>At least 12 characters.</small></label>':''}<p id="auth-status" class="muted" role="status">${escape(message)}</p><button class="btn btn-primary" id="auth-submit">${{signin:'Sign in',signup:'Create pilot account',forgot:'Request reset email',reset:'Save new password'}[mode]}</button></div></form><div class="auth-links"><button id="auth-switch" class="text-btn">${mode==='signin'?'Create an invited account':'Back to sign in'}</button>${mode==='signin'?'<button id="auth-forgot" class="text-btn">Forgot password?</button><button id="auth-resend" class="text-btn">Resend verification email</button>':''}<a href="/demo" class="text-btn">Explore the fictional demo →</a></div></section>`;
+  target.innerHTML=`<section class="card auth-card"><div class="card-head"><div><span class="eyebrow">YOUR INDEPENDENT ALPHA ACCOUNT</span><h1>${{signin:'Welcome back.',signup:'A workspace of your own.',forgot:'Reset your password.',reset:'Choose a new password.'}[mode]}</h1><p>${mode==='signup'?'Private pilot registration is restricted to invited email addresses.':'Personal records stay private to your account.'}</p></div></div><form id="auth-form" class="card-body"><div class="auth-fields">${mode==='signup'?'<label class="field">Your name<input name="name" required maxlength="100" autocomplete="name"></label>':''}${mode!=='reset'?'<label class="field">Email address<input name="email" type="email" required maxlength="254" autocomplete="email"></label>':''}${mode === 'forgot' ? '' : passwordField(mode)}<p id="auth-status" class="muted" role="status">${escape(message)}</p><button class="btn btn-primary" id="auth-submit">${{signin:'Sign in',signup:'Create pilot account',forgot:'Request reset email',reset:'Save new password'}[mode]}</button></div></form><div class="auth-links"><button id="auth-switch" class="text-btn">${mode==='signin'?'Create an invited account':'Back to sign in'}</button>${mode==='signin'?'<button id="auth-forgot" class="text-btn">Forgot password?</button><button id="auth-resend" class="text-btn">Resend verification email</button>':''}<a href="/demo" class="text-btn">Explore the fictional demo →</a></div></section>`;
+  bindPasswordVisibility(target.querySelector('#auth-form'));
   document.querySelector('#auth-switch').onclick=()=>{mode=mode==='signin'?'signup':'signin';message='';draw();};
   const forgot=document.querySelector('#auth-forgot');if(forgot)forgot.onclick=()=>{mode='forgot';message='';draw();};
   const resend=document.querySelector('#auth-resend');if(resend)resend.onclick=async()=>{const email=target.querySelector('[name=email]').value;if(!email){target.querySelector('#auth-status').textContent='Enter your email address above first.';return;}resend.disabled=true;try{await api('/api/auth/send-verification-email',{email,callbackURL:'/workspace'});target.querySelector('#auth-status').textContent='Verification requested. Check your inbox if the address is eligible.';}catch(e){target.querySelector('#auth-status').textContent=e.message;}finally{resend.disabled=false;}};
diff --git a/public/styles.css b/public/styles.css
index e459d39..25568bf 100644
--- a/public/styles.css
+++ b/public/styles.css
@@ -1,3 +1,37 @@
+/* Keep the toggle beside the input so password managers can use its trailing edge. */
+.auth-password-control {
+  display: flex;
+  gap: 8px;
+}
+.auth-card .auth-password-control input {
+  flex: 1 1 0;
+  min-width: 0;
+  border-color: #dce6d1;
+  background: #fff;
+  font-weight: 400;
+}
+.auth-password-control .auth-password-toggle {
+  flex: 0 0 auto;
+  min-height: 44px;
+  min-width: 74px;
+}
+.auth-password-eye {
+  display: inline-grid;
+  place-items: center;
+  width: 13px;
+  height: 13px;
+  border: 1px solid currentColor;
+  border-radius: 75% 12%;
+  transform: rotate(45deg);
+}
+.auth-password-eye::after {
+  content: "";
+  width: 4px;
+  height: 4px;
+  border-radius: 50%;
+  background: currentColor;
+}
+
 
 :root{--canvas:#f8f9f5;--paper:#fff;--ink:#2b332c;--muted:#7c8279;--olive:#526647;--olive-dark:#354b36;--line:#e6e9e1;--soft:#eff2e9;--warm:#f2eee4;--radius:12px;font-family:Arial,Helvetica,sans-serif;color:var(--ink);background:var(--canvas);font-synthesis:none}
 *{box-sizing:border-box}body{margin:0}button,input,textarea,select{font:inherit}button,a,input,select,textarea{-webkit-tap-highlight-color:transparent}button,a,select{touch-action:manipulation}button{cursor:pointer}button:disabled{cursor:default;opacity:.55}button{color:inherit}a{color:inherit;text-decoration:none}button{border:0;background:none}button:focus-visible,a:focus-visible,select:focus-visible,input:focus-visible,textarea:focus-visible,[tabindex]:focus-visible{outline:2px solid #779364;outline-offset:4px}input,select,textarea{background:#fff;color:var(--ink);border:1px solid #dce1d5;border-radius:7px}input,select{height:41px;padding:0 12px}textarea{padding:12px;resize:vertical;line-height:1.6}input::placeholder,textarea::placeholder{color:#7a8372}h1,h2,h3,p{margin:0}h2{font-size:15px;font-weight:600;letter-spacing:-.3px}h3{font-size:14px;font-weight:600}svg{flex-shrink:0}small{font-size:12px}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}.muted{color:var(--muted)}.text-small{font-size:13px}.text-amber{color:#a27a43!important}.text-green{color:var(--olive)}.spin{animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
